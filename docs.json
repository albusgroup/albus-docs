{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Albus Documentation",
  "theme": "mint",
  "colors": {
    "primary": "#1F6FEB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": ["index", "getting-started/authentication"]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/build-an-agent",
          "guides/bring-your-own-key",
          "guides/built-in-tools",
          "guides/mcp-server-auth",
          "guides/troubleshooting"
        ]
      },
      {
        "group": "Reference",
        "pages": ["reference/cli", "reference/sdks", "reference/errors"]
      },
      {
        "group": "API reference",
        "openapi": "openapi/openapi.yaml"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:carlo@albus.sh"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://albus.sh"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/albusgroup"
    }
  },
  "redirects": [
    {
      "source": "/getting-started/api",
      "destination": "/getting-started/authentication"
    },
    {
      "source": "/getting-started/authenticate",
      "destination": "/getting-started/authentication"
    },
    {
      "source": "/getting-started/access",
      "destination": "/getting-started/authentication"
    },
    {
      "source": "/getting-started/install",
      "destination": "/getting-started/authentication"
    },
    {
      "source": "/getting-started/first-session",
      "destination": "/"
    },
    {
      "source": "/getting-started/for-your-agent",
      "destination": "/agents/docs"
    },
    {
      "source": "/getting-started/python",
      "destination": "/reference/sdks"
    },
    {
      "source": "/guides/agents",
      "destination": "/agents/docs"
    },
    {
      "source": "/agents/setup",
      "destination": "/agents/docs"
    },
    {
      "source": "/agents/examples",
      "destination": "/agents/docs"
    },
    {
      "source": "/guides/run-a-session",
      "destination": "/guides/build-an-agent"
    },
    {
      "source": "/guides/secrets",
      "destination": "/guides/build-an-agent#5-add-a-secret-and-an-mcp-server"
    },
    {
      "source": "/guides/mcp-servers",
      "destination": "/guides/build-an-agent#5-add-a-secret-and-an-mcp-server"
    },
    {
      "source": "/guides/agents-and-revisions",
      "destination": "/guides/build-an-agent#8-every-change-is-a-revision"
    },
    {
      "source": "/guides/audit-log",
      "destination": "/guides/build-an-agent#9-the-audit-log"
    },
    {
      "source": "/guides/model-providers",
      "destination": "/guides/bring-your-own-key"
    },
    {
      "source": "/guides/releases",
      "destination": "/reference/sdks"
    },
    {
      "source": "/reference/overview",
      "destination": "/api-reference/sessions/run-or-resume-a-session"
    },
    {
      "source": "/alpha/limitations",
      "destination": "/"
    },
    {
      "source": "/alpha/support",
      "destination": "/"
    },
    {
      "source": "/beta/limitations",
      "destination": "/"
    },
    {
      "source": "/beta/support",
      "destination": "/"
    }
  ]
}
