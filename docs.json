{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Albus Documentation",
  "theme": "mint",
  "colors": {
    "primary": "#1F6FEB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "banner": {
    "content": "Albus is in private beta: invite-only, 20 session runs per organization. [What that means](/beta/limitations)",
    "dismissible": true
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "getting-started/access",
          "getting-started/install",
          "getting-started/authenticate",
          "getting-started/first-session",
          "getting-started/for-your-agent"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/run-a-session",
          "guides/secrets",
          "guides/mcp-servers",
          "guides/model-providers",
          "guides/agents-and-revisions",
          "guides/audit-log",
          "guides/troubleshooting"
        ]
      },
      {
        "group": "For coding agents",
        "pages": ["agents/docs"]
      },
      {
        "group": "Private beta",
        "pages": ["beta/limitations", "beta/support"]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/sdks",
          "reference/errors",
          "reference/overview",
          "guides/releases"
        ]
      },
      {
        "group": "API reference",
        "openapi": "openapi/openapi.yaml"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:carlo@albus.sh"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://albus.sh"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/albusgroup"
    }
  },
  "redirects": [
    {
      "source": "/getting-started/api",
      "destination": "/getting-started/authenticate"
    },
    {
      "source": "/getting-started/python",
      "destination": "/reference/sdks"
    },
    {
      "source": "/guides/agents",
      "destination": "/agents/docs"
    },
    {
      "source": "/agents/setup",
      "destination": "/agents/docs"
    },
    {
      "source": "/agents/examples",
      "destination": "/agents/docs"
    },
    {
      "source": "/alpha/limitations",
      "destination": "/beta/limitations"
    },
    {
      "source": "/alpha/support",
      "destination": "/beta/support"
    }
  ]
}
